<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.lnyo-cly.community</groupId>
        <artifactId>ai4j-plugins-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>ai4j-plugin-dynamic-workflow</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>ai4j-plugin-dynamic-workflow</name>
    <description>AI4J dynamic workflow extension plugin for host-mediated workflow orchestration.</description>
    <url>https://github.com/LnYo-Cly/ai4j-plugins/tree/main/plugins/dynamic-workflow</url>

    <developers>
        <developer>
            <id>cly</id>
            <name>LnYo-Cly</name>
            <url>https://github.com/LnYo-Cly</url>
        </developer>
    </developers>

    <properties>
        <ai4j-agent.version>2.4.2</ai4j-agent.version>
        <live.provider.test.category>io.github.lnyocly.ai4j.test.LiveProviderTest</live.provider.test.category>
        <test.groups></test.groups>
        <test.excludedGroups>${live.provider.test.category}</test.excludedGroups>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.lnyo-cly</groupId>
            <artifactId>ai4j-extension-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <version>2.0.43</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.12.4</version>
                <configuration>
                    <groups>${test.groups}</groups>
                    <excludedGroups>${test.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>live-ai4j-agent-tests</id>
            <dependencies>
                <dependency>
                    <groupId>io.github.lnyo-cly</groupId>
                    <artifactId>ai4j-agent</artifactId>
                    <version>${ai4j-agent.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
